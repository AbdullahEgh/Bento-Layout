<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Bento</AssemblyName>
    <Version>0.3.14</Version>
    <ApplicationIcon>Assets/bento.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Bento.Windows/Bento.Windows.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/bento.ico" /><Resource Include="Assets/bento.png" /></ItemGroup>
</Project>

